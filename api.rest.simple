# REST API request template
# Values read from .env (same folder) via {{$dotenv ...}}; wrapped as file
# variables so request bodies keep the clean {{var}} names.

@baseUrl = {{$dotenv baseUrl}}
@adminFirstName = {{$dotenv adminFirstName}}
@adminLastName = {{$dotenv adminLastName}}
@adminEmail = {{$dotenv adminEmail}}
@adminPassword = {{$dotenv adminPassword}}

@userUsername = {{$dotenv userUsername}}
@userEmail = {{$dotenv userEmail}}
@userPassword = {{$dotenv userPassword}}

### 1. Admin Section
### 1.1 Register Admin
# @name adminRegister
POST {{baseUrl}}/admin/auth/register-admin
Content-Type: application/json

{
  "firstname": "{{adminFirstName}}",
  "lastname": "{{adminLastName}}",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "rememberMe": true
}

### 1.2 Admin Login
# @name adminLogin
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "rememberMe": true
}

### 1.3 Admin Forgot Password
# @name adminForgotPassword
POST {{baseUrl}}/admin/auth/forgot-password
Content-Type: application/json

{
  "email": "{{adminEmail}}"
}

### 1.4 Admin Profile
# @name adminProfile
GET {{baseUrl}}/admin/auth/users/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

### 2. User Section
### 2.1 User Register 
# @name userRegister
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "{{userUsername}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.2 User Login
# @name userLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "identifier": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.3 User Forgot Password
# @name userForgotPassword
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{userEmail}}"
}

### 2.4 User Profile
# @name userProfile
GET {{baseUrl}}/api/auth/users/me
Authorization: Bearer {{userLogin.response.body.$.jwt}}