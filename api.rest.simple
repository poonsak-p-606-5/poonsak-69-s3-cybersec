# REST API request template
# Values read from .env (same folder) via {{$dotenv ...}}; wrapped as file
# variables so request bodies keep the clean {{var}} names.
# Endpoints are the real Strapi routes on this server (admin = /admin/*,
# users = Users & Permissions /api/auth/local*). keep baseUrl localhost, or
# use HTTPS before exposing off-machine.

@baseUrl = {{$dotenv baseUrl}}
@adminFirstName = {{$dotenv adminFirstName}}
@adminLastName = {{$dotenv adminLastName}}
@adminEmail = {{$dotenv adminEmail}}
@adminPassword = {{$dotenv adminPassword}}

@userUsername = {{$dotenv userUsername}}
@userEmail = {{$dotenv userEmail}}
@userPassword = {{$dotenv userPassword}}

## 1. Admin Section
### 1.1 Admin Login
# @name adminLogin
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "rememberMe": false
}

### 1.2 Admin Profile
# @name adminProfile
GET {{baseUrl}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

## 2. User Section
### 2.1 User Register
# @name userRegister
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
  "username": "{{userUsername}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.2 User Login
# @name userLogin
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
  "identifier": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.3 User Profile
# @name userProfile
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userLogin.response.body.$.jwt}}